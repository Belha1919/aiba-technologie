# --- AIBA chatbot (local AI via Ollama) ---
# Copy this file to `.env.local` and adjust, then restart `npm run dev`.

# Which local model the pricing chatbot uses. Pull it first, e.g.:
#   ollama pull qwen2.5:3b
# Good fits for ~4 GB VRAM: qwen2.5:3b, llama3.2, llama3.2:1b, gemma2:2b
OLLAMA_MODEL=qwen2.5:3b

# Ollama server URL (default local service). Uncomment to override.
# OLLAMA_URL=http://127.0.0.1:11434
